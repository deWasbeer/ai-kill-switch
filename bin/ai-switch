#!/usr/bin/env python3
"""ai-switch: network kill switch for AI platforms on OpenWrt + AdGuard Home.

Runs on the Pi. Install as /usr/local/bin/ai-switch and symlink the ai-* names
to it; the name you call it by decides what it does:

  ai-off / ai-on [provider ...]   block / unblock (every provider when none given)
  ai-status                       what is blocked, plus the latest route report
  ai-update                       daily job: refresh lists and report route changes
  ai-idle                         every few minutes: block everything after IDLE_HOURS without AI traffic
  ai-whitelist [provider ...]     show the whitelist, or add providers that are never blocked
  ai-unwhitelist provider ...     take providers off the whitelist

Block lists live in ~/.config/ai-switch/providers/<name>/:
  domains  one domain per line (subdomains included); lines starting with / | @ are raw AdGuard rules
  ranges   IP ranges the router firewall rejects
  hosts    hostnames whose routes are tracked daily
Create a new folder there to add a provider of your own.

Network settings can be overridden in ~/.config/ai-switch/config (KEY=value lines):
  ROUTER=192.168.1.1                 router that runs AdGuard Home and nftables (reached as root over SSH)
  AGH=http://192.168.1.1:8080        AdGuard Home URL
  IDLE_IGNORE_CLIENTS=192.168.1.50   comma-separated IPs whose AI lookups never count as activity
  IDLE_HOURS=2
  MAX_ON_HOURS=8
AdGuard credentials go in ~/.config/ai-switch/agh-auth as user:password (chmod 600).
"""
import base64
import http.client
import ipaddress
import json
import re
import socket
import subprocess
import sys
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timedelta, timezone
from pathlib import Path

CONF = Path.home() / ".config/ai-switch"


def _config():
    cfg = {}
    try:
        for line in (CONF / "config").read_text().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip().strip('"')
    except OSError:
        pass
    return cfg


_CFG = _config()
ROUTER = _CFG.get("ROUTER", "192.168.1.1")
AGH = _CFG.get("AGH", f"http://{ROUTER}:8080")
DOH = "https://1.1.1.1/dns-query"  # by IP, so lookups still work if DoH hostnames get blocked
NFT_TABLE = "ai_kill"
WATCH_LIMIT = 40  # hostnames tracked per provider
MAX_ON_HOURS = float(_CFG.get("MAX_ON_HOURS", 8))  # hard cap: block everything this long after the last ai-on, whatever the traffic
IDLE_IGNORE_DOMAINS = ["a-api.anthropic.com", "a-cdn.anthropic.com", "downloads.claude.ai",
                       "statsig.anthropic.com"]  # telemetry/updaters: not a person using AI
# Machines that run AI agents (e.g. Claude Code): their own traffic must not keep AI on
IDLE_IGNORE_CLIENTS = [c.strip() for c in _CFG.get("IDLE_IGNORE_CLIENTS", "").split(",") if c.strip()]
IDLE_HOURS = float(_CFG.get("IDLE_HOURS", 2))    # block every provider after this long without AI traffic on the network
LOG_PAGES = 10    # x 1000 AdGuard query log entries scanned per update
UA = "Mozilla/5.0 (X11; Linux x86_64) ai-switch"
# Certificate log checks per run. Free without a key is only a handful of lookups an hour,
# so domains are checked in rotation; with a key in ~/.config/ai-switch/certspotter-key all are checked.
CT_PER_RUN_NO_KEY = 4
# CDN/cloud infrastructure names that turn up on shared certificates; never an AI domain.
INFRA = ("cloudflaressl.com", "cloudflare.com", "cloudflare.net", "amazonaws.com", "cloudfront.net",
         "azureedge.net", "azurefd.net", "akamaiedge.net", "fastly.net", "googleusercontent.com")

